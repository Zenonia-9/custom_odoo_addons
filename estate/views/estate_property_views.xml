<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                
                <field name="name" string="Title"/>
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area"/>
                <field name="facades" />
                <field name="property_type_id"/>

                <filter string="Available"
                        name="active"
                        domain="['|',
                                    ('state', '=', 'new'),
                                    ('state', '=', 'received')]"/>
                
                <group expand="1" string="Group By">
                        <filter 
                            string="Postcode" 
                            name="postcode" 
                            context="{'group_by':'postcode'}"
                        />
                        <filter
                            string="Property Type"
                            name="group_property_type"
                            context="{'group_by': 'property_type_id'}"
                        />
                </group>

            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <header>
                    <button string="Sold" name="action_sold" type="object" class="oe_highlight"/>
                    <button string="Cancle" name="action_cancle" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,received,accepted,sold"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>

                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <group>
                            <field name="property_type_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="best_price" />
                            <field name="selling_price" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                            </group>

                            <group>
                                <group>
                                    <field name="bedrooms" />
                                    <field name="living_area" />
                                    <field name="facades" />
                                    <field name="garage" />
                                    <field name="garden" />
                                </group>
                                <group>
                                    <field name="garden_area"/>
                                    <field name="garden_orientation"/>
                                    <field name="total_area" />
                                </group>
                            </group>
                        </page>

                        <page string="Offers">
                            <field name="offer_ids">
                                <tree editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity" />
                                    <field name="date_deadline" />
                                    <button name="action_accept" help="Accept" type="object" class="oe_highlight" icon="fa-check"/>
                                    <button name="action_refuse" help="Refuse" type="object" class="oe_highlight" icon="fa-times"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Other Info">
                            <group>
                                <field name="salesman_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties">
                <field name="name" string="Title"/>
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area"/>
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" />
            </tree>
        </field>
    </record>
                
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban View -->
    <record id="view_estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable="false" group_create="false">
                <field name="name"/>
                <field name="state" />
                <field name="selling_price" />
                <field name="best_price" />
                <field name="property_type_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" style="padding:10px; border:1px solid #ccc; margin-bottom:10px; border-radius:5px;">
                            
                            <strong><field name="name"/></strong>

                            <div>Expected Price: $<field name="expected_price"/></div>
                            
                            <div t-if="record.state.raw_value == 'received'">
                                Best Offer: $<field name="best_price" />
                            </div>
                            
                            <div t-if="record.state.raw_value == 'Accepted'">
                                Selling Price: $<field name="selling_price"/>
                            </div>
                            
                            <field name="tag_ids" widget="many2many_tags" readonly="state in ['sold', 'cancelled']" options="{'color_field': 'color'}"/>
                            
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                
                <field name="name" string="Title"/>
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area" filter_domain="[('living_area', '>=', self)]" />
                <field name="facades" />
                <field name="property_type_id"/>

                <filter string="Available"
                        name="active"
                        domain="['|',
                                    ('state', '=', 'new'),
                                    ('state', '=', 'received')]"/>
                <group expand="1" string="Group By">
                        <filter 
                            string="Postcode" 
                            name="postcode" 
                            context="{'group_by':'postcode'}"
                        />
                        <filter
                            string="Property Type"
                            name="group_property_type"
                            context="{'group_by': 'property_type_id'}"
                        />
                </group>

            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <header>
                    <button string="Sold" name="action_sold" invisible="state == 'sold' or state == 'cancelled'" type="object" class="oe_highlight"/>
                    <button string="Cancel" name="action_cancle" invisible="state == 'sold' or state == 'cancelled'"  type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,received,accepted,sold"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="state in ['sold', 'cancelled']"/>
                    </h1>

                    <group>
                        <field name="tag_ids" widget="many2many_tags" readonly="state in ['sold', 'cancelled']" options="{'color_field': 'color'}"/>
                        <group>
                            <field name="property_type_id" readonly="state in ['sold', 'cancelled']" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="postcode" readonly="state in ['sold', 'cancelled']" />
                            <field name="date_availability" readonly="state in ['sold', 'cancelled']" />
                        </group>
                        <group>
                            <field name="expected_price" readonly="state in ['sold', 'cancelled']" />
                            <field name="best_price" />
                            <field name="selling_price" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"  readonly="state in ['sold', 'cancelled']"/>
                            </group>

                            <group>
                                <group>
                                    <field name="bedrooms" readonly="state in ['sold', 'cancelled']" />
                                    <field name="living_area" readonly="state in ['sold', 'cancelled']" />
                                    <field name="facades" readonly="state in ['sold', 'cancelled']" />
                                    <field name="garden_area" readonly="state in ['sold', 'cancelled']" invisible="not garden"/>
                                    <field name="garden_orientation" readonly="state in ['sold', 'cancelled']" invisible="not garden"/>
                                </group>
                                <group>
                                    <field name="garage" readonly="state in ['sold', 'cancelled']" />
                                    <field name="garden" readonly="state in ['sold', 'cancelled']" />
                                    <field name="total_area" readonly="state in ['sold', 'cancelled']" />
                                </group>
                            </group>
                        </page>

                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ['accepted', 'sold', 'cancelled']">
                                <tree editable="bottom" decoration-success="status=='accepted'" decoration-danger="status=='refused'" >
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity" />
                                    <field name="date_deadline" />
                                    <button name="action_accept" invisible="status in ['accepted', 'refused']" help="Accept" type="object" class="oe_highlight" icon="fa-check"/>
                                    <button name="action_refuse" invisible="status in ['accepted', 'refused']" help="Refuse" type="object" class="oe_highlight" icon="fa-times"/>
                                    <field name="status" column_invisible="1" />
                                </tree>
                            </field>
                        </page>

                        <page string="Other Info">
                            <group>
                                <field name="salesman_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties" 
                    decoration-success="state == 'received' or state == 'accepted'"
                    decoration-bf="state == 'accepted'"
                    decoration-muted="state == 'sold'"
                    decoration-danger="state == 'cancelled'">
                <field name="name" string="Title"/>
                <field name="property_type_id"/>
                <field name="postcode" />
                <field name="tag_ids"  widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="bedrooms" />
                <field name="living_area"/>
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" optional="hide" />
                <field name="state" column_invisible="1" />
            </tree>
        </field>
    </record>
                
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
